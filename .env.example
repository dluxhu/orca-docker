# Copy to ".env" and fill in. Never commit the real .env.

# ── Required ─────────────────────────────────────────────────────────────────

# The address Orca clients dial. Use an address your desktop can reach:
#   the NAS LAN IP          192.168.1.10
#   its Tailscale name      nas.tailnet-name.ts.net   (or its 100.x.y.z IP)
#   a full URL              ws://nas.local:6768       (when the published port differs)
# Never 127.0.0.1 or 0.0.0.0.
ORCA_PAIRING_ADDRESS=

# Synology file ownership. SSH into the NAS and run `id` as your user.
# 1026/100 is typical for the first admin user and the "users" group.
PUID=1026
PGID=100

# The ONE host folder mounted into the container. It becomes /home ($HOME):
# Orca state, agent CLIs and logins, ssh keys, projects. Create it first and
# chown it to PUID:PGID. An encrypted shared folder is fine (see README).
HOME_DIR=/volume1/docker/orca/home

# ── Optional ─────────────────────────────────────────────────────────────────

# Port of the Orca server, inside and outside the container.
ORCA_PORT=6768

# Agent CLIs installed into HOME_DIR on first start. "none" skips it.
# `install-agents list` inside the container shows all names.
ORCA_AGENTS=claude codex

# Orca profile backups with short file names, for encrypted shared folders:
# auto (when HOME_DIR rejects long names) | on | off.
ORCA_PROFILE_BACKUP=auto

# Extra flags for `orca-ide serve`, e.g. --mobile-pairing (QR code for Orca Mobile).
ORCA_SERVE_ARGS=

# Git identity for commits made on the server.
GIT_USER_NAME=
GIT_USER_EMAIL=

# GitHub token for gh and git push over https (optional; `gh auth login` in the
# container works too).
GH_TOKEN=

# Claude Code token from `claude setup-token` (optional; `orca account add` or
# `claude` login in the container works too).
CLAUDE_CODE_OAUTH_TOKEN=

TZ=UTC

# Extra apt packages baked in when you build locally with --build.
EXTRA_PACKAGES=

# Only with docker-compose.docker.yml: group id of /var/run/docker.sock on the host.
#   stat -c %g /var/run/docker.sock
DOCKER_GID=
