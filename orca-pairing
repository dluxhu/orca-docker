#!/usr/bin/env bash
# Print the pairing links of the running Orca server.
#   docker exec orca-server orca-pairing
# The links grant access to this server. Treat them like a password.
set -euo pipefail

SERVE_LOG="${HOME}/.config/orca-docker/serve.log"
[ -r "${SERVE_LOG}" ] || { echo "No server output yet (${SERVE_LOG}). Is the server running?" >&2; exit 1; }

grep -E '^(Orca server ready|Bound endpoint|Advertised endpoint|Pairing|Web client URL|Mobile)' "${SERVE_LOG}" || true

if ! grep -q '^Pairing URL:' "${SERVE_LOG}"; then
  echo >&2
  echo "No pairing link. If the server is still starting, wait for 'Orca server ready' in the" >&2
  echo "container log. A 'Pairing unavailable' line above gives the reason." >&2
  if [ "$(wc -l < "${SERVE_LOG}")" -ge 1000 ]; then
    echo "${SERVE_LOG} keeps only the first 1000 lines and is full: look in 'docker logs orca-server'." >&2
  fi
  exit 1
fi

echo
case " ${ORCA_SERVE_ARGS:-} " in
  *" --mobile-pairing "*)
    cat <<'NOTE'
ORCA_SERVE_ARGS has --mobile-pairing: this link is for Orca Mobile only. Scan the QR code in
`docker logs orca-server`, or paste the link in Orca Mobile. To pair a desktop or a browser,
remove the flag and restart the container.
NOTE
    ;;
  *)
    cat <<'NOTE'
Desktop: Settings → Remote Orca Servers → Add Server → paste the Pairing URL.
Browser: open the Web client URL.
NOTE
    ;;
esac
echo "A link pairs one client. For another client, restart the container to print a new link."
